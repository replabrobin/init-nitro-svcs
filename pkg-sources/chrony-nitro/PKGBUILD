        'ace5cef605072b62c01239230eff57d08b0b445c8214179d7cbc4318bea8602588be64f5c90eff25766d8c423e1a100562bfd2d1ee14eff97bf4b787b9908ba5')
package() {
	install -Dm755 "$srcdir"/chrony.run "$pkgdir/etc/nitro/sv/chrony/run"
	install -Dm755 "$srcdir"/chrony.conf "$pkgdir/etc/nitro/sv/chrony/conf"
}
