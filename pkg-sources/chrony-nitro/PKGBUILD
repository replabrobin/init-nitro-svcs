	'92f342ebc03b1683996366ae8c65458d35ca073e90700991aa8c48fa38094fd5ff26458096e84722303f0d6586fe27e997cb82f628cf4ca046f4190b67168e0c'
	'5de76a5f619d63818d9a2b148b47ca93a5601618b1790e866fd8d0534af03b854cd0384b6281b3eb9ce95d7ed9dac61d7c9f45fef7984a410b48001e7f1a2dec'
	)
package() {
	install -Dm755 "$srcdir"/chrony.run "$pkgdir/etc/nitro/sv/chrony/run"
	install -Dm755 "$srcdir"/chrony.conf "$pkgdir/etc/nitro/sv/chrony/conf"
}
