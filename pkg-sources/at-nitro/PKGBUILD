# Maintainer: replabrobin <replabrobin@gmail.com>
pkgname='at-nitro'
pkgver='20260730'
pkgrel='2'
pkgdesc='nitro service script for at'
_tag=3.0 # alpm-hooks
arch=('any')
url="https://github.com/replabrobin/init-nitro-svcs"
license=('BSD')
#groups=('nitro-galaxy')

provides=(
	'init-at'
	)

depends=(
	'at'
	'nitro'
	)

source=(
	"git+https://gitea.artixlinux.org/artix/alpm-hooks.git#tag=$_tag"
	at.run
	"alpm-hooks-001.patch"
	)
prepare(){
	cd "$srcdir/alpm-hooks"
	patch -p1 -i "$srcdir/alpm-hooks-001.patch"
}
b2sums=('654b9166c85afd17ccaf4deed1803669b2a38fa36399dc83e399aa7b6261f6a58fe79609d3840cec55a84cbe2e7e5e403569412baedc274988d37ca8693bf14e'
        'ad7e97922f3d1abcb437e40d8bb6f4e719b9ac4d86730b0d2df892fa0553d3f9aafbc6642418eaa308093615634ef98e7b401f8a8696da9d5b8ab2df5a90622a'
        '54e7613d6f608d1ee5e0daade53baf35c712c2883f6dc58e3927195ad28ae6682bff9e7381dedd3c08d54053133a9f466e995cbeebf9de17857942c022832e75')
package() {
	install -Dm755 "$srcdir"/at.run "$pkgdir/etc/nitro/sv/at/run"

    # alpm hooks
    cd "${srcdir}"/alpm-hooks
    DESTDIR="${pkgdir}" make install_nitro_at
}
