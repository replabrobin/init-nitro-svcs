	'gdm'
	'init-logind'
	)

source=(
	gdm.run
	)
b2sums=('f0c4f017bbe5078e3ee1931f9ede10cfc23ce477cb4b31b36fcc3e2fea4bcbbbd29f223befcf844e4deebbf8e28b1ea4327923042ed6e39d6d94cc32db6c9d91')
package() {
	install -Dm755 "$srcdir"/gdm.run "$pkgdir/etc/nitro/sv/gdm/run"
}
