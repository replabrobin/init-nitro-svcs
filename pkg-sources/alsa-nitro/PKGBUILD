pkgname='alsa-nitro'
pkgver='20251104'
pkgrel='1'
pkgdesc='nitro service script for alsa'
arch=('any')
url="https://github.com/replabrobin/init-nitro-svcs"
license=('BSD')
#groups=('nitro-galaxy')
provides=(
	'init-alsa'
	)

depends=(
	'alsa'
	'nitro'
	)

source=(
	alsa.run
	alsa.finish
	)
b2sums=('baf65afdc60f5460a88dcc68f95b0e63b48a5d947c5b8fb48aa7419e65f5c35d64a518df1a0e820d92c8c8766ae95b5f60e6a393c738e70950943a831da255f7'
        '76da57c8e2f7a76022acab2adce3c58a679bae52ab2aa723cc67b68f9ad8c1161de31967a9809a50a7d6f4f650f9cbe367532710e53638c82351683dc9263cfc')
package() {
	install -Dm755 "$srcdir"/alsa.run "$pkgdir/etc/nitro/sv/alsa/run"
	install -Dm755 "$srcdir"/alsa.finish "$pkgdir/etc/nitro/sv/alsa/finish"
}
