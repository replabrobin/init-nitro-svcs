        'bebd3d284da3c0ec261a4b870b6b7e9bf1378bd22bdcfec57fc80c7a93fc31d8418404ec9c6fbeb7c0b79e9b95b925b4b69ee96108e27d5aeaf67a6a2a2eee0a')
package() {
	install -Dm755 "$srcdir"/uwsgi.run "$pkgdir/etc/nitro/sv/uwsgi/run"
	install -Dm755 "$srcdir"/uwsgi.finish "$pkgdir/etc/nitro/sv/uwsgi/finish"
}
