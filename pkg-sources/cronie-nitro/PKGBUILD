# Maintainer: replabrobin <replabrobin@gmail.com>
pkgname='cronie-nitro'
pkgver='20260731'
pkgrel='1'
pkgdesc='nitro service script for cronie'
_tag=3.0 # alpm-hooks
arch=('any')
url="https://github.com/replabrobin/init-nitro-svcs"
license=('BSD')
#groups=('nitro-galaxy')
makedepends=('git')
depends=('cronie' 'nitro')
provides=('init-cronie' 'init-cron')
conflicts=('fcron' 'init-cronie' 'init-cron')

source=(
	cronie.run
	"git+https://gitea.artixlinux.org/artix/alpm-hooks.git#tag=$_tag"
	"alpm-hooks-001.patch"
	)
b2sums=('4ab132709a7bf6e53c16511181c5558ed5f2ba7ce641be2832dcb4ef3cefab17323203dfcdcdb7800d9cbc420face0975aa4bdb9925b64be14a466c6fd514783'
        '654b9166c85afd17ccaf4deed1803669b2a38fa36399dc83e399aa7b6261f6a58fe79609d3840cec55a84cbe2e7e5e403569412baedc274988d37ca8693bf14e'
        '5c9b7dac854f9655c90d061601b1e16d7c46ee8b227f6072e91d6af73a663364cfcdff0c0f81b31590dbb924280eff8f4e8e7ec3790f785fc3508765c93a9de1')
prepare(){
	cd "$srcdir/alpm-hooks"
	patch -p1 -i "$srcdir/alpm-hooks-001.patch"
}
package() {
	install -Dm755 "$srcdir"/cronie.run "$pkgdir/etc/nitro/sv/cronie/run"

    # alpm hooks
    cd "${srcdir}"/alpm-hooks
    DESTDIR="${pkgdir}" make install_nitro_cronie
}
