	install -Dm755 "$srcdir"/seatd.run "$pkgdir/etc/nitro/sv/seatd/run"
	install -Dm666 "$srcdir"/seatd.notification-fd "$pkgdir/etc/nitro/sv/seatd/notification-fd"
}
